{
  "name": "@cccsharonparish/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "copy:mdd.me:assets": "rsync -a --ignore-existing common/mydailydigest/public/ apps/mydailydigest.me/public/",
    "copy:admin.mdd.me:assets": "rsync -a --ignore-existing common/mydailydigest/public/ apps/admin.mydailydigest.me/public/",
    "copy:mdd:global:assets": "pnpm run copy:mdd.me:assets && pnpm run copy:admin.mdd.me:assets",
    "serve:mdd.me": "pnpm run copy:mdd:global:assets && nx run mydailydigest.me:serve:development --port=4400",
    "serve:admin.mdd.me": "pnpm run copy:admin.mdd.me:assets && nx run admin.mydailydigest.me:serve:development --port=4300",
    "serve:mdd": "pnpm run copy:mdd:global:assets && pnpm run serve:admin.mdd.me && pnpm run serve:mdd.me",
    "cy:open:admin.mdd.me": "cd apps/admin.mydailydigest.me-e2e && npx cypress open",
    "cy:mdd.me": "nx e2e mydailydigest.me-e2e",
    "cy:admin.mdd.me": "nx e2e admin.mydailydigest.me-e2e",
    "cy:all": "pnpm run cy:admin.mdd.me && pnpm run cy:mdd.me",
    "lint:core": "nx lint core",
    "lint:angular": "nx lint angular",
    "lint:mdd": "nx lint mydailydigest",
    "lint:mdd.me": "nx lint mydailydigest.me",
    "lint:admin.mdd.me": "nx lint admin.mydailydigest.me",
    "lint:all": "pnpm run lint:core && pnpm run lint:angular && pnpm run lint:ui && pnpm run lint:common && pnpm run lint:mdd.me && pnpm run lint:admin.mdd.me",
    "build:admin.mdd.me": "nx build admin.mydailydigest.me",
    "build:mdd.me": "nx build mydailydigest.me",
    "build:mdd": "pnpm run build:mdd.me && pnpm run build:admin.mdd.me",
    "build:admin.mdd.me:prod": "nx build admin.mydailydigest.me --configuration=production",
    "build:mdd.me:prod": "nx build mydailydigest.me --configuration=production",
    "build:mdd:prod": "pnpm run build:mdd.me:prod && pnpm run build:admin.mdd.me:prod",
    "build:admin.mdd.me:staging": "nx build admin.mydailydigest.me --configuration=staging",
    "build:mdd.me:staging": "nx build mydailydigest.me --configuration=staging",
    "build:mdd:staging": "pnpm run build:mdd.me:staging && pnpm run build:admin.mdd.me:staging",
    "test:admin.mdd.me": "nx test admin.mydailydigest.me",
    "test:mdd.me": "nx test mydailydigest.me",
    "test:core": "nx test core",
    "test:mdd": "nx test mydailydigest",
    "test:angular": "nx test angular",
    "test:all": "pnpm run test:core && pnpm run test:angular && pnpm run test:ui && pnpm run test:common && pnpm run test:mdd.me && pnpm run test:admin.mdd.me"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.1",
    "@angular/cdk": "19.2.2",
    "@angular/common": "19.2.1",
    "@angular/compiler": "19.2.1",
    "@angular/core": "19.2.1",
    "@angular/fire": "19.0.0",
    "@angular/forms": "19.2.1",
    "@angular/material": "~19.1.0",
    "@angular/platform-browser": "19.2.1",
