    "@angular/platform-server": "19.2.1",
    "@angular/router": "19.2.1",
    "@angular/ssr": "19.2.1",
    "@jsverse/transloco": "^7.5.0",
    "@jsverse/transloco-utils": "^7.0.2",
    "@ngrx/signals": "^18.1.1",
    "@taiga-ui/addon-mobile": "^4.20.0",
    "@taiga-ui/addon-table": "^4.20.0",
    "@taiga-ui/cdk": "^4.20.0",
